[user]
  name = chintan357
  email = chintan357@localhost

[init]
  defaultBranch = main

[core]
  autocrlf = input
  editor = nvim
  pager = delta
  ; excludesFile = ~/.gitignore

[push]
  default = current
  ; autoSetupRemote = true

[pull]
  ff = only

[fetch]
  prune = true

[alias]
  a = add

  b = branch
  bl = branch -l --sort=committerdate
  br = branch -r
  ba = branch -a

  c = commit
  cm = commit -m
  cu = commit --amend

  ; cp = cherry-pick
  
  f = fetch
  fo = fetch origin
  fu = fetch upstream

  g = grep -p

  l = log --oneline --decorate
  ll = log --stat
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  lga = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

  o = checkout
  om = checkout main
  ob = checkout -b

  ls = ls-files
  ; lsg = !git ls-files | grep -i

  p = push
  pf = push --force-with-lease
  pt = push --tags

  Po = pull origin
  Pu = pull upstream

  m = merge
  ma = merge --abort

  r = remote
  ra = remote add
  rrm = remote rm
  rv = remote -v

  rb = rebase
  rbi = rebase --interactive
  rbc = rebase --continue

  re = reset
  reh = reset --hard
  res = reset --soft
  rehom = reset --hard origin/main

  ; rmf = rm -f
  ; rmrf = rm -r -f

  s = stash
  sl = stash list

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true # use n and N to move between diff sections
  line-numbers = true
  syntax-theme = OneHalfDark
  ; true-color = always
  ; dark = true
  side-by-side = true
  features = arctic-fox

[delta "arctic-fox"]
  # author: https://github.com/anthony-halim
  file-style = omit
  hunk-header-decoration-style = "#5E81AC" ul
  hunk-header-file-style = blue ul bold
  hunk-header-line-number-style = yellow box bold
  hunk-header-style = file line-number syntax bold italic
  plus-style = brightgreen
  plus-emph-style = black green
  minus-style = brightred
  minus-emph-style = black red
  line-numbers-minus-style = brightred
  line-numbers-plus-style = brightgreen
  line-numbers-left-style = "#5E81AC"
  line-numbers-right-style = "#5E81AC"
  line-numbers-zero-style = "#4C566A"
  merge-conflict-begin-symbol = ~
  merge-conflict-end-symbol = ~
  merge-conflict-ours-diff-header-style = yellow bold
  merge-conflict-ours-diff-header-decoration-style = "#5E81AC" box
  merge-conflict-theirs-diff-header-style = yellow bold
  merge-conflict-theirs-diff-header-decoration-style = "#5E81AC" box
  whitespace-error-style = black bold
  ; zero-style = syntax
  ; file-added-label = [+]
  ; file-copied-label = [==]
  ; file-modified-label = [*]
  ; file-removed-label = [-]
  ; file-renamed-label = [->]
  ; blame-code-style = syntax
  ; blame-format = "{author:<18} {commit:<6} {timestamp:<15}"
  ; blame-palette = "#2E3440" "#3B4252" "#434C5E"
