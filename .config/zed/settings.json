// https://zed.dev/docs/configuring-zed
// `zed: open default settings`
{
  "cli_default_open_behavior": "existing_window",
  "buffer_font_family": "Mononoki Nerd Font Propo",
  "terminal": {
    "font_family": "Mononoki Nerd Font Propo"
  },
  "tab_size": 2,
  "indent_guides": {
    "line_width": 1,
    "active_line_width": 3,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "redact_private_values": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed"
  },
  "show_edit_predictions": false,
  "project_panel": {
    "dock": "left",
    "hide_root": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "agent_servers": {
    "amp-acp": {
      "type": "registry"
    },
    "pi-acp": {
      "default_model": "openai-codex/gpt-5.5",
      "default_mode": "minimal",
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "model": "openai/gpt-5.5"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "low"
      },
      "type": "registry"
    }
  },
  "agent": {
    "dock": "right",
    "default_profile": "minimal",
    "default_model": {
      "effort": "low",
      "enable_thinking": false,
      "provider": "openai-subscribed",
      "model": "gpt-5.5"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "wsl_connections": [
    {
      "distro_name": "Ubuntu",
      "user": null,
      "projects": [
        {
          "paths": ["/home/cpatel/lab/zed"]
        },
        {
          "paths": ["/home/cpatel/pw/zed"]
        }
      ]
    }
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Warm Charmed Icons"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "tabs": {
    "file_icons": true
  },
  "cursor_shape": "block",
  "cursor_blink": false,
  "gutter": {
    "min_line_number_digits": 0
  },
  "colorize_brackets": true,
  "wrap_guides": [80, 120],
  "preferred_line_length": 80,
  "completion_menu_item_kind": "symbol"

  // "languages": {
  //     "Python": {
  //         "format_on_save": "on",
  //         "formatter": {
  //             "language_server": {
  //                 "name": "ruff"
  //             }
